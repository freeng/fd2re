# Build inputs required by the native and Pages CI builds despite the *.sav /
# *.tmp rules above: the initial save image and the game's sprite temp file.
!/FD2.SAV
!/fd2re/FD2.TMP

# Large generated analysis exports
tmp_*.json

# One-off analysis scratch (IDA/decompiler dumps, drive scripts, build smoke logs)
tmp_*.py
*_tmp.json
*_tmp*.txt
ida_tmp*.txt
/d[0-9a-f][0-9a-f]*.json
smoke_err.txt
tools/states_gen_out.c

# Round-74/76 event-audit scratch (mcp_call dumps, disassembly JSONs)
work_tmp/

# Local reverse-engineering scratch (not source or reproducible tools)
/.zcode/
/tools/_dis_*.txt
/tools/_out*.jsonl
/tools/idalib_local.py
/fd2re/tools/preview.*.png

# Vendored libADLMIDI build output (source tree is tracked, built libs are not)
**/vendor/libADLMIDI/build-msvc/

# fd2dat generated data — regenerable from repo-root originals via
# tools/dat_export.py + dat_pack.py (re-exported wholesale on every tool fix)
/fd2re/tools/dat-modern/
/fd2re/tools/preview/

# Policy: the public repository carries the reconstruction only (fd2re + web).
# The reverse-engineering workspace and verbatim original install files stay
# local — analysis scripts and evidence notes, the IDA database, the original
# game executables and Miles AIL drivers/configs are not distributed.
/FD2.EXE.i64
/reverse/
/tools/
/runtest/
/agents.md
/fd2.conf
/run_fd2.bat
